DEBUG=false
SECRET_KEY=replace-with-a-new-long-random-secret
# Standalone local development only. Shared production inherits the existing root
# DATABASE_URL automatically via config.shared_settings; no second database.
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=.grcustasi.com
CSRF_TRUSTED_ORIGINS=
TENANT_BASE_DOMAIN=grcustasi.com
ROOT_SIGNIN_ENABLED=true
SECURE_SSL_REDIRECT=true
GRCUSTASI_TELEGRAM_BOT_TOKEN=
GRCUSTASI_TELEGRAM_ADMIN_CHAT_ID=

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
